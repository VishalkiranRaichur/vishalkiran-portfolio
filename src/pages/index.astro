---
import Layout from '../layouts/Layout.astro';
---
<Layout title='Vishalkiran Raichur · AI systems & backend infrastructure' description='I take things apart, then build them better. AI systems and backend infrastructure by Vishalkiran Raichur, Data Science at San José State.' active="home">
<style is:global>


*{box-sizing:border-box;margin:0;padding:0}
:root{--paper:#fcfaf6;--ink:#111;--mut:#6f6d68;--dim:#a19e97;--line:rgba(17,17,17,.14);--or:#ff5a1f}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:JO,"Avenir Next",system-ui,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
.m{font-family:PM,ui-monospace,monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--mut)}
.wrap{max-width:1360px;margin:0 auto;padding:0 48px}
.or{color:var(--or)}
/* nav */
.nav{position:sticky;top:0;z-index:40;background:rgba(252,250,246,.92);border-bottom:1px solid transparent;transition:border-color .3s}
.nav.sc{border-color:var(--line)}
.nav .wrap{height:84px;display:flex;align-items:center;justify-content:space-between}
.logo{font-weight:400;font-size:17px;letter-spacing:.22em;line-height:1.05;text-transform:uppercase}
.logo span{display:block}.logo i{font-style:normal;color:var(--or)}
.links{display:flex;gap:38px}
.links a{font-size:12px;letter-spacing:.2em;text-transform:uppercase;position:relative;padding:6px 0}
.links a::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:1px;background:var(--ink);transition:right .4s cubic-bezier(.6,0,.2,1)}
.links a:hover::after,.links a.on::after{right:0}
.links a sup{font-family:PM;font-size:9px;color:var(--dim);margin-right:6px;letter-spacing:.05em}
.nr{display:flex;align-items:center;gap:14px}
.srch{display:flex;align-items:center;gap:40px;border:1px solid var(--line);border-radius:999px;padding:9px 10px 9px 16px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--mut);cursor:pointer;transition:border-color .2s}
.srch:hover{border-color:var(--ink)}
.kbd{font-family:PM;font-size:10px;border:1px solid var(--line);border-radius:5px;padding:2px 6px;letter-spacing:.05em}
.pillb{display:inline-flex;align-items:center;gap:12px;border:1px solid var(--ink);border-radius:999px;padding:12px 20px;font-size:12px;letter-spacing:.2em;text-transform:uppercase;transition:background .25s,color .25s}
.pillb:hover{background:var(--ink);color:var(--paper)}
.pillb.solid{background:var(--ink);color:var(--paper)}
.pillb.solid:hover{background:transparent;color:var(--ink)}
.arr{display:inline-block;width:22px;height:1px;background:currentColor;position:relative}
.arr::after{content:"";position:absolute;right:0;top:-3px;width:7px;height:7px;border-top:1px solid currentColor;border-right:1px solid currentColor;transform:rotate(45deg)}
/* strip */
.strip{display:flex;justify-content:space-between;align-items:center;padding:30px 0 0}
.strip .sep{margin:0 14px;color:var(--dim)}
.live{display:flex;align-items:center;gap:10px}
.live i{width:7px;height:7px;border-radius:50%;background:var(--or);animation:rec 1.6s steps(1) infinite}
@keyframes rec{50%{opacity:.15}}
/* hero */
.hero{display:grid;grid-template-columns:1fr 470px;gap:64px;align-items:end;padding:60px 0 0}
.badge{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:11px;letter-spacing:.18em;text-transform:uppercase}
.badge i{width:6px;height:6px;border-radius:50%;background:var(--or)}
h1{font-weight:300;font-size:clamp(56px,7.6vw,112px);line-height:.98;letter-spacing:-.01em;text-transform:uppercase;margin-top:30px}
h1 .ln{display:block;overflow:hidden}
h1 .ln>span{display:inline-block;transform:translateY(102%);animation:up 1s cubic-bezier(.2,.8,.2,1) forwards}
h1 .ln:nth-child(2)>span{animation-delay:.08s}h1 .ln:nth-child(3)>span{animation-delay:.16s}h1 .ln:nth-child(4)>span{animation-delay:.24s}
@keyframes up{to{transform:none}}
.apart{display:inline-flex}
.apart b{font-weight:300;display:inline-block;transition:transform 1.4s cubic-bezier(.2,.8,.2,1)}
.dot{color:var(--or)}
.intro{display:grid;grid-template-columns:1fr 470px;gap:64px;margin-top:44px;align-items:start}
.intro p{font-size:19px;line-height:1.65;color:#2b2a28;max-width:620px}
.intro p em{font-style:normal;border-bottom:1px solid var(--or)}
.btns{display:flex;gap:12px;margin-top:32px}
/* viewfinder */
.vf{position:relative;border:1px solid var(--ink);aspect-ratio:4/3.4;overflow:hidden;background:var(--paper)}
.vf .c{position:absolute;width:16px;height:16px;border-color:var(--ink);border-style:solid}
.vf .tl{left:10px;top:10px;border-width:1px 0 0 1px}.vf .tr{right:10px;top:10px;border-width:1px 1px 0 0}.vf .bl{left:10px;bottom:10px;border-width:0 0 1px 1px}.vf .br{right:10px;bottom:10px;border-width:0 1px 1px 0}
.vf .hd{position:absolute;left:0;right:0;top:0;display:flex;justify-content:space-between;padding:14px 34px;font-family:PM;font-size:10px;letter-spacing:.16em}
.vf .ft{position:absolute;left:0;right:0;bottom:0;display:flex;justify-content:space-between;padding:14px 34px;font-family:PM;font-size:10px;letter-spacing:.16em;color:var(--mut)}
.vf svg{position:absolute;inset:0;width:100%;height:100%}
.vf .pt{transform-box:fill-box;transform-origin:center;transition:transform 1.3s cubic-bezier(.2,.9,.25,1)}
.vf .ld{transition:opacity .6s}
.vf.built .ld,.vf.built .cross{opacity:0}
.cross{transition:opacity .6s}
.cross{position:absolute;left:50%;top:50%;width:60px;height:60px;margin:-30px;opacity:.35}
.cross::before,.cross::after{content:"";position:absolute;background:var(--ink)}.cross::before{left:50%;top:0;bottom:0;width:1px}.cross::after{top:50%;left:0;right:0;height:1px}
/* build log */
.log{margin-top:70px;border-top:1px solid var(--ink);border-bottom:1px solid var(--line);display:grid;grid-template-columns:200px 1fr 160px;align-items:center}
.log>div{padding:18px 0}
.log .tx{font-family:PM;font-size:12.5px;color:#2b2a28;white-space:nowrap;overflow:hidden}
.log .tx .ok{color:var(--or)}
.scroll{display:flex;align-items:center;gap:10px;justify-content:flex-end}
.scroll i{width:1px;height:26px;background:var(--line);position:relative;overflow:hidden}
.scroll i::after{content:"";position:absolute;left:0;top:-10px;width:1px;height:10px;background:var(--ink);animation:sc 1.6s infinite}
@keyframes sc{to{top:26px}}
/* sections */
.sec{padding:140px 0 0}
.sh{display:flex;justify-content:space-between;align-items:flex-end;gap:40px}
.sh h2{font-weight:300;font-size:clamp(44px,5.2vw,78px);line-height:1;text-transform:uppercase;letter-spacing:-.005em;margin-top:22px}
.ul{font-size:12px;letter-spacing:.2em;text-transform:uppercase;display:inline-flex;gap:12px;align-items:center;border-bottom:1px solid var(--ink);padding-bottom:6px}
/* work cards */
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:56px}
.card{display:block}
.card .vf{aspect-ratio:4/3;transition:background .4s}
.card:hover .vf{background:#f3efe7}
.card .vf svg{transition:transform 1s cubic-bezier(.2,.8,.2,1)}
.card:hover .vf svg{transform:scale(1.04)}
.card .row{display:flex;justify-content:space-between;align-items:baseline;margin-top:20px}
.card h3{font-weight:400;font-size:28px;letter-spacing:.02em;text-transform:uppercase}
.card p{font-size:16.5px;color:#3a3936;margin-top:6px;line-height:1.5}
.card .st{display:flex;align-items:center;gap:8px;margin-top:14px}
.card .st i{width:6px;height:6px;border-radius:50%;background:var(--or)}
.card .st i.g{background:var(--dim)}
/* what i do */
.do{margin-top:56px;border-top:1px solid var(--ink)}
.dr{display:grid;grid-template-columns:90px 1fr 1fr;gap:40px;padding:34px 0;border-bottom:1px solid var(--line);align-items:baseline;transition:padding .4s}
.dr:hover{padding-left:12px}
.dr .n{font-family:PM;font-size:12px;color:var(--or);letter-spacing:.1em}
.dr h4{font-weight:300;font-size:38px;text-transform:uppercase;letter-spacing:.01em}
.dr p{font-size:17px;line-height:1.6;color:#3a3936;max-width:520px}
/* currently */
.cur{margin-top:56px;display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end;border:1px solid var(--ink);padding:44px 48px;position:relative}
.cur h3{font-weight:300;font-size:clamp(34px,3.6vw,52px);line-height:1.08;text-transform:uppercase;margin-top:16px;max-width:900px}
.cur p{font-size:17px;color:#3a3936;margin-top:14px}
/* cta */
.cta{padding:170px 0 120px;text-align:center}
.cta h2{font-weight:300;font-size:clamp(56px,8.4vw,128px);line-height:.96;text-transform:uppercase}
.cta p{font-size:19px;color:#3a3936;margin-top:26px}
.cta .btns{justify-content:center;margin-top:38px}
.foot{border-top:1px solid var(--ink);display:grid;grid-template-columns:repeat(4,1fr);gap:40px;padding:40px 0 60px}
.foot b{display:block;font-weight:400;font-size:15px;margin-top:12px;line-height:1.8}
/* reveal */
.rv{opacity:0;transform:translateY(24px);transition:opacity 1s cubic-bezier(.2,.8,.2,1),transform 1s cubic-bezier(.2,.8,.2,1)}
.rv.in{opacity:1;transform:none}.d1{transition-delay:.1s}.d2{transition-delay:.2s}.d3{transition-delay:.3s}
@media (max-width:960px){
 .wrap{padding:0 18px}.links,.srch .t{display:none}.srch{gap:6px;padding:8px 10px}.nr .pillb{display:none}
 .hero,.intro{grid-template-columns:1fr;gap:36px}.strip .tg{display:none}
 .log{grid-template-columns:1fr}.log>div:first-child,.log .scroll{display:none}
 .sh{flex-direction:column;align-items:flex-start}
 .cards{grid-template-columns:1fr}.dr{grid-template-columns:1fr;gap:10px}.cur{grid-template-columns:1fr;padding:28px}
 .foot{grid-template-columns:1fr 1fr}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}h1 .ln>span{transform:none}}

</style>




<main class="wrap">
 <div class="strip m"><span class="tg">AI Systems<span class="sep">|</span>Backend<span class="sep">|</span>Infrastructure</span><span class="live"><i></i>Live · San José · <span id="clk">00:00:00</span></span></div>

 <section class="hero">
  <div>
   <span class="badge"><i></i>Open to internships</span>
   <h1><span class="ln"><span>I take things</span></span><span class="ln"><span class="apart" id="apart"><b>A</b><b>P</b><b>A</b><b>R</b><b>T</b><b>.</b></span></span><span class="ln"><span>Then I build</span></span><span class="ln"><span>them better<span class="dot">.</span></span></span></h1>
  </div>
  <div class="vf" id="vf">
   <span class="c tl"></span><span class="c tr"></span><span class="c bl"></span><span class="c br"></span>
   <div class="hd"><span>FIG. 01</span><span id="vfs">● DISASSEMBLED</span></div>
   <span class="cross"></span>
   <svg viewBox="0 0 470 400" id="part"></svg>
   <div class="ft"><span>THE FIRST THING I TOOK APART</span><span>HOVER TO BUILD</span></div>
  </div>
 </section>

 <section class="intro">
  <div>
   <p>I'm a Data Science student at San José State who builds <em>AI systems</em> and <em>backend infrastructure</em>. I like the problems underneath the app: AI that has to show its evidence, pipelines that have to survive a crash, and databases built from the disk page up.</p>
   <div class="btns"><a class="pillb solid" href="/projects">See the work <span class="arr"></span></a><a class="pillb" href="/resume">Résumé</a></div>
  </div>
  <div class="m" style="line-height:2;padding-top:6px">B.S. Data Science · SJSU · 2028<br>Previously · RCC · Relling Systems · SCE<br>Currently · Adobe Student Ambassador</div>
 </section>

 <div class="log">
  <div class="m">Build log</div>
  <div class="tx" id="log"></div>
  <div class="scroll m">Scroll <i></i></div>
 </div>

 <section class="sec" id="work">
  <div class="sh"><div><div class="m rv">01 · Selected work</div><h2 class="rv d1">Things built to hold up.</h2></div><a class="ul rv d2" href="/projects">All projects <span class="arr"></span></a></div>
  <div class="cards">
   <a class="card rv" href="/projects/orion"><div class="vf"><span class="c tl"></span><span class="c tr"></span><span class="c bl"></span><span class="c br"></span><div class="hd"><span>BUILD 01</span><span>AI SYSTEMS</span></div>
    <svg viewBox="0 0 400 300"><g fill="none" stroke="#111" stroke-width="1.2"><rect x="70" y="70" width="260" height="170"/><polyline points="96,190 140,178 182,184 222,166 262,214 304,206"/></g><circle cx="262" cy="214" r="5" fill="#ff5a1f"/><text x="272" y="204" font-family="PM" font-size="10" fill="#ff5a1f">−18%</text><text x="96" y="100" font-family="PM" font-size="9" letter-spacing="1.5" fill="#6f6d68">EXECUTIVE BRIEF</text><text x="96" y="124" font-family="JO" font-size="15" fill="#111">Why did revenue drop in July?</text><line x1="96" y1="224" x2="230" y2="224" stroke="#111" stroke-width="3"/><text x="96" y="262" font-family="PM" font-size="9" letter-spacing="1.5" fill="#6f6d68">88.9% · ONE CUSTOMER · EVIDENCE ✓</text></svg></div>
    <div class="row"><h3>ORION</h3><span class="m">AI agent</span></div><p>An AI analyst that refuses to guess.</p><div class="st m"><i></i>In active development</div></a>
   <a class="card rv d1" href="/projects/pulsegrid"><div class="vf"><span class="c tl"></span><span class="c tr"></span><span class="c bl"></span><span class="c br"></span><div class="hd"><span>BUILD 02</span><span>INFRASTRUCTURE</span></div>
    <svg viewBox="0 0 400 300"><g fill="none" stroke="#111" stroke-width="1.2"><path d="M110 150 C140 150 140 105 160 105M110 150 C140 150 140 195 160 195M220 105 C250 105 250 150 270 150M220 195 C250 195 250 150 270 150"/><rect x="60" y="134" width="50" height="32"/><rect x="160" y="89" width="60" height="32"/><rect x="160" y="179" width="60" height="32"/><rect x="270" y="134" width="70" height="32" stroke="#ff5a1f"/></g><g font-family="PM" font-size="10" fill="#111" text-anchor="middle"><text x="85" y="154">push</text><text x="190" y="109">lint</text><text x="190" y="199">test</text><text x="305" y="154" fill="#ff5a1f">build</text></g><text x="60" y="250" font-family="PM" font-size="9" letter-spacing="1.5" fill="#6f6d68">WORKER-A · LEASE 75S · HEARTBEAT ✓</text></svg></div>
    <div class="row"><h3>PulseGrid</h3><span class="m">CI platform</span></div><p>A CI system that recovers when workers die.</p><div class="st m"><i class="g"></i>Case study</div></a>
   <a class="card rv d2" href="/projects/forgedb"><div class="vf"><span class="c tl"></span><span class="c tr"></span><span class="c bl"></span><span class="c br"></span><div class="hd"><span>BUILD 03</span><span>SYSTEMS</span></div>
    <svg viewBox="0 0 400 300"><g fill="none" stroke="#111" stroke-width="1.2"><rect x="176" y="70" width="48" height="28" stroke="#ff5a1f"/><path d="M190 98 L120 140 M210 98 L280 140 M110 168 L80 210 M120 168 L120 210 M130 168 L160 210 M270 168 L240 210 M280 168 L280 210 M290 168 L320 210"/><rect x="90" y="140" width="60" height="28"/><rect x="250" y="140" width="60" height="28"/><rect x="64" y="210" width="32" height="22"/><rect x="104" y="210" width="32" height="22"/><rect x="144" y="210" width="32" height="22"/><rect x="224" y="210" width="32" height="22"/><rect x="264" y="210" width="32" height="22"/><rect x="304" y="210" width="32" height="22"/></g><g font-family="PM" font-size="10" text-anchor="middle"><text x="200" y="88" fill="#ff5a1f">42</text><text x="120" y="158">17 · 29</text><text x="280" y="158">58 · 77</text></g><text x="64" y="262" font-family="PM" font-size="9" letter-spacing="1.5" fill="#6f6d68">4 KB PAGES · LRU BUFFER POOL · B+ TREE</text></svg></div>
    <div class="row"><h3>ForgeDB</h3><span class="m">Database engine</span></div><p>A database written from the disk page up.</p><div class="st m"><i class="g"></i>Case study</div></a>
  </div>
 </section>

 <section class="sec" id="do">
  <div class="sh"><div><div class="m rv">02 · What I do</div><h2 class="rv d1">Three things I'm good at.</h2></div></div>
  <div class="do">
   <div class="dr rv"><span class="n">01</span><h4>AI systems</h4><p>Agents and retrieval that work from real evidence, with tests that check they can say “I don't know.”</p></div>
   <div class="dr rv d1"><span class="n">02</span><h4>Backend &amp; infra</h4><p>APIs, job queues, schedulers and storage engines, built to retry, recover and keep data safe.</p></div>
   <div class="dr rv d2"><span class="n">03</span><h4>Web &amp; product</h4><p>Fast, clean interfaces people actually use, from a studio site for local shops to dashboards for thousands of students.</p></div>
  </div>
 </section>

 <section class="sec" id="cur">
  <div class="m rv">03 · Most recently</div>
  <div class="cur rv d1"><div><div class="m">Jan – May 2026 · RCC, SJSU</div><h3>Built the backend for an AI readability app.</h3><p>Flask, document processing and a local AI model, with a team of six.</p></div><a class="ul" href="/work">See the full path <span class="arr"></span></a></div>
 </section>

 <section class="cta" id="contact">
  <div class="m rv">Start a conversation</div>
  <h2 class="rv d1" style="margin-top:26px">Got a hard problem?<br>Let's take it apart<span class="dot">.</span></h2>
  <p class="rv d2">Open to SWE, AI/ML and backend internships, and problems worth the effort.</p>
  <div class="btns rv d3"><a class="pillb solid" href="mailto:vishalkiran.raichur@sjsu.edu">Email me <span class="arr"></span></a><a class="pillb" href="https://www.linkedin.com/in/vishalkiran-raichur/" target="_blank" rel="noopener">LinkedIn</a><a class="pillb" href="https://github.com/VishalkiranRaichur" target="_blank" rel="noopener">GitHub</a></div>
 </section>
</main>

<script is:inline>
// live clock (REC-style)
const ck=document.getElementById('clk');const tk=()=>{ck.textContent=new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit',timeZone:'America/Los_Angeles'}).format(new Date())};tk();setInterval(tk,1000);
// nav border
addEventListener('scroll',()=>document.getElementById('nav').classList.toggle('sc',scrollY>10),{passive:true});
// "APART" letters drift apart / together
const ap=[...document.querySelectorAll('#apart b')];const off=[-14,10,-6,18,-10,8];
setTimeout(()=>ap.forEach((b,i)=>{b.style.transform=`translate(${i*10}px,${off[i]}px) rotate(${off[i]/3}deg)`}),1100);
// exploded drawing
const P=[
 ['<path d="M150 190 q14-46 66-50 h56 q42 3 60 50" fill="none" stroke="#111" stroke-width="1.4"/>',-40,-70,-14,'ROOF'],
 ['<rect x="120" y="190" width="240" height="44" rx="14" fill="none" stroke="#111" stroke-width="1.4"/>',0,0,0,'CHASSIS'],
 ['<path d="M214 145 v42 M270 142 v45" stroke="#111" stroke-width="1.2"/>',30,-110,0,''],
 ['<g><circle cx="178" cy="252" r="28" fill="#fcfaf6" stroke="#111" stroke-width="1.4"/><circle cx="178" cy="252" r="8" fill="none" stroke="#111"/></g>',-110,60,0,'WHEEL L'],
 ['<g><circle cx="304" cy="252" r="28" fill="#fcfaf6" stroke="#111" stroke-width="1.4"/><circle cx="304" cy="252" r="8" fill="none" stroke="#111"/></g>',110,60,0,'WHEEL R'],
 ['<g><rect x="214" y="200" width="54" height="24" fill="#fcfaf6" stroke="#ff5a1f" stroke-width="1.4"/><path d="M222 212 h38" stroke="#ff5a1f"/></g>',0,120,0,'MOTOR'],
 ['<path d="M332 190 l22 -58" stroke="#111" stroke-width="1.4"/><circle cx="354" cy="130" r="4" fill="#ff5a1f"/>',70,-60,20,'ANTENNA'],
];
const sv=document.getElementById('part');
sv.innerHTML=P.map(p=>`<g class="pt">${p[0]}</g>`).join('')+P.map((p,i)=>p[4]?`<g class="ld"><text font-family="PM" font-size="9" letter-spacing="1.5" fill="#6f6d68" data-i="${i}">${p[4]}</text></g>`:'').join('');
const gs=[...sv.querySelectorAll('.pt')],vf=document.getElementById('vf'),vfs=document.getElementById('vfs');
function place(t){gs.forEach((g,i)=>{const p=P[i];g.style.transform=`translate(${p[1]*t}px,${p[2]*t}px) rotate(${p[3]*t}deg)`});
 sv.querySelectorAll('text[data-i]').forEach(tx=>{const i=+tx.dataset.i,b=gs[i].getBBox(),p=P[i];tx.setAttribute('x',b.x+b.width/2+p[1]*t-20);tx.setAttribute('y',b.y+p[2]*t-8)})}
place(1);
const build=()=>{place(0);ap.forEach(b=>b.style.transform='none');vf.classList.add('built');vfs.textContent='● BUILT ✓';vfs.style.color='#ff5a1f'};
const unbuild=()=>{place(1);ap.forEach((b,i)=>{b.style.transform=`translate(${i*10}px,${off[i]}px) rotate(${off[i]/3}deg)`});vf.classList.remove('built');vfs.textContent='● DISASSEMBLED';vfs.style.color=''};
vf.addEventListener('pointerenter',build);vf.addEventListener('pointerleave',unbuild);vf.addEventListener('click',()=>vf.classList.contains('built')?unbuild():build());
// build log typewriter
const L=['$ build --profile vishal','curiosity ........ ok','backend .......... ok','ai systems ....... ok','status: shipping'];
const lg=document.getElementById('log');let li=0,ci=0,acc='';
(function ty(){const s=L[li];if(ci<=s.length){lg.innerHTML=acc+s.slice(0,ci).replace(/ok$/,'<span class="ok">ok</span>');ci++;setTimeout(ty,28)}else{acc+=s.replace(/ok$/,'<span class="ok">ok</span>')+'&nbsp;&nbsp;&nbsp;';li=(li+1);ci=0;if(li<L.length)setTimeout(ty,280)}})();
// reveal
