---
import Layout from '../layouts/Layout.astro';
---
<Layout title='Contact · Vishalkiran Raichur' description='Open to SWE, AI/ML and backend internships.' active="contact">
<style is:global>



.grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;padding:90px 0 0;align-items:start}
h1{font-weight:300;font-size:clamp(56px,7.6vw,116px);line-height:.96;text-transform:uppercase;margin-top:24px}
h1 .ln{display:block;overflow:hidden}h1 .ln>span{display:inline-block;transform:translateY(102%);animation:up 1s cubic-bezier(.2,.8,.2,1) forwards}
h1 .ln:nth-child(2)>span{animation-delay:.08s}h1 .ln:nth-child(3)>span{animation-delay:.16s}
@keyframes up{to{transform:none}}
.lede{font-size:19px;line-height:1.65;color:#2b2a28;margin-top:28px;max-width:520px}
.chan{margin-top:44px;border-top:1px solid var(--ink)}
.chan a{display:grid;grid-template-columns:110px 1fr auto;gap:16px;align-items:center;padding:18px 0;border-bottom:1px solid var(--line);font-size:18px;transition:padding .35s}
.chan a:hover{padding-left:12px}
.chan a span:first-child{font-family:PM;font-size:10.5px;letter-spacing:.14em;color:var(--mut)}
.chan a .arr{color:var(--or)}
.where{margin-top:30px;display:flex;gap:30px}
.where div b{display:block;font-weight:400;font-size:16px;margin-top:6px}
.live{display:inline-flex;align-items:center;gap:8px}.live i{width:7px;height:7px;border-radius:50%;background:var(--or);animation:rec 1.6s steps(1) infinite}
@keyframes rec{50%{opacity:.2}}
form{border:1px solid var(--ink);position:relative;background:var(--paper)}
form .c{position:absolute;width:16px;height:16px;border-color:var(--ink);border-style:solid}
form .tl{left:10px;top:10px;border-width:1px 0 0 1px}form .tr{right:10px;top:10px;border-width:1px 1px 0 0}form .bl{left:10px;bottom:10px;border-width:0 0 1px 1px}form .br{right:10px;bottom:10px;border-width:0 1px 1px 0}
.fh{display:flex;justify-content:space-between;padding:16px 34px;font-family:PM;font-size:10px;letter-spacing:.16em;border-bottom:1px solid var(--line)}
.fb{padding:10px 34px 34px}
label{display:block;margin-top:22px}
label span{font-family:PM;font-size:10.5px;letter-spacing:.14em;color:var(--mut)}
input,textarea,select{width:100%;font:17px JO,sans-serif;color:var(--ink);background:transparent;border:0;border-bottom:1px solid var(--ink);padding:10px 0;outline:none;border-radius:0;transition:border-color .2s}
input:focus,textarea:focus,select:focus{border-color:var(--or)}
textarea{resize:vertical;min-height:120px}
.topics{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.topics input{display:none}
.topics label{margin:0}
.topics label span{display:inline-block;font-family:JO;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink);border:1px solid var(--ink);border-radius:999px;padding:8px 14px;cursor:pointer;transition:.2s}
.topics input:checked+span{background:var(--ink);color:var(--paper)}
.send{margin-top:30px;width:100%;justify-content:center;font:inherit;font-size:12px;cursor:pointer}
.ok{display:none;padding:60px 34px;text-align:center}
.ok b{display:block;font-weight:300;font-size:40px;text-transform:uppercase}
.ok p{font-size:16px;color:#3a3936;margin-top:10px}
form.sent .fb{display:none}form.sent .ok{display:block}
.foot{border-top:1px solid var(--ink);display:grid;grid-template-columns:repeat(4,1fr);gap:40px;padding:40px 0 60px;margin-top:130px}
.foot b{display:block;font-weight:400;font-size:15px;margin-top:12px;line-height:1.8}
@media (max-width:960px){.wrap{padding:0 18px}.links,.srch .t{display:none}.srch{gap:6px;padding:8px 10px}.nr .pillb{display:none}
 .grid{grid-template-columns:1fr;gap:50px;padding-top:50px}.chan a{grid-template-columns:80px 1fr auto;font-size:16px}.fh{padding:14px 18px}.fb{padding:6px 18px 24px}.foot{grid-template-columns:1fr 1fr}}

</style>




<main class="wrap">
 <section class="grid">
  <div>
   <div class="m">Contact</div>
   <h1><span class="ln"><span>Let's build</span></span><span class="ln"><span>something</span></span><span class="ln"><span>that works<span class="or">.</span></span></span></h1>
   <p class="lede">Open to SWE, AI/ML and backend internships, and to hard problems worth taking apart. The fastest way to reach me is right here.</p>
   <div class="chan">
    <a href="mailto:vishalkiran.raichur@sjsu.edu"><span>EMAIL</span><span>vishalkiran.raichur@sjsu.edu</span><span class="arr"></span></a>
    <a href="https://www.linkedin.com/in/vishalkiran-raichur/" target="_blank" rel="noopener"><span>LINKEDIN</span><span>linkedin.com/in/vishalkiran-raichur</span><span class="arr"></span></a>
    <a href="https://github.com/VishalkiranRaichur" target="_blank" rel="noopener"><span>GITHUB</span><span>github.com/VishalkiranRaichur</span><span class="arr"></span></a>
    <a href="/resume"><span>RÉSUMÉ</span><span>One-page version</span><span class="arr"></span></a>
   </div>
   <div class="where m"><div>Based in<b>San José, California</b></div><div>Local time<b><span class="live"><i></i><span id="clk">--:--</span></span></b></div></div>
  </div>

  <form id="f" name="contact" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="contact"><p style="display:none"><label>Skip <input name="bot-field"></label></p>
   <span class="c tl"></span><span class="c tr"></span><span class="c bl"></span><span class="c br"></span>
   <div class="fh"><span>FIG. 01 · SAY HELLO</span><span>SAN JOSÉ · PACIFIC TIME</span></div>
   <div class="fb">
    <label><span>NAME</span><input required name="name" placeholder="Your name"></label>
    <label><span>EMAIL</span><input required name="email" type="email" placeholder="you@company.com"></label>
    <div style="margin-top:24px"><span class="m">ABOUT</span>
     <div class="topics"><label><input type="radio" name="topic" value="Internship" checked><span>Internship</span></label><label><input type="radio" name="topic" value="A project"><span>A project</span></label><label><input type="radio" name="topic" value="Just saying hi"><span>Just saying hi</span></label></div></div>
    <label><span>MESSAGE</span><textarea required name="message" placeholder="What are you building?"></textarea></label>
    <button class="pillb solid send">Send message <span class="arr"></span></button>
   </div>
   </form>
 </section>
</main>
<script is:inline>
const ck=document.getElementById('clk');const tk=()=>{ck.textContent=new Intl.DateTimeFormat('en-US',{hour:'numeric',minute:'2-digit',timeZone:'America/Los_Angeles'}).format(new Date())};tk();setInterval(tk,30000);
addEventListener('scroll',()=>document.getElementById('nav').classList.toggle('sc',scrollY>10),{passive:true});
</script>

</Layout>
