 ()=>pane(chaos?'Outcome unknown':'Credit requested','STRIPE TEST MODE',`<div class="log" id="log"></div>`),
 ()=>pane('Credit verified','READ-AFTER-WRITE',`<div class="tbl"><div class="vt"><span>CHECK</span><span>EXPECTED</span><span>OBSERVED</span><span></span></div><div class="vt"><span>Customer</span><code>cus_acme…</code><code>cus_acme…</code><span class="ok">✓</span></div><div class="vt"><span>Amount</span><code>−$420.00</code><code>−$420.00</code><span class="ok">✓</span></div><div class="vt"><span>Metadata</span><code>case INC-47</code><code>case INC-47</code><span class="ok">✓</span></div><div class="vt"><span>Matching credits</span><code>1</code><code>1</code><span class="ok">✓</span></div></div><p class="why">${chaos?'Even after the timeout, the system of record shows <b>exactly one</b> credit. No duplicate was issued.':'The verifier reads Stripe again and compares <b>expected vs. observed</b> state, independent of what the agent reported.'}</p>`),
 ()=>pane('Audited','LINEAR',`<div class="card"><div class="r"><small>ISSUE</small><span>INC-47 · exports-api SEV-1 · service credits</span></div><div class="r"><small>ACME</small><span class="ok">CREDIT_VERIFIED · $420.00</span></div><div class="r"><small>GLOBEX</small><span class="no">NOT_ELIGIBLE · plan</span></div><div class="r"><small>UMBRELLA</small><span class="no">NOT_ELIGIBLE · no usage</span></div><div class="r"><small>RAW EVIDENCE</small><span>Event IDs, policy version, inputs and outputs of every step</span></div></div>`),
 ()=>pane('Closed','ALL SYSTEMS AGREE',`<div class="idle" style="padding:30px 0"><div><b>Case closed ✓</b>PagerDuty, PostHog, policy and Stripe agree on the outcome.</div></div><div class="closer">The agent didn't “complete a workflow” because it called Stripe. It completed it because <b>the correct customer received the policy-authorized credit, exactly once</b>, and we verified it from the system of record.</div>`)];
function go(i){step=i;states(i,chaos&&i===4);VIEWS[i]();
 const nx=$('next');nx.disabled=(i===3||i>=7);nx.textContent=i>=7?'Done':'Next step →';
 if(i===3){$('approve').onclick=()=>go(4);$('deny').onclick=()=>pane('Rejected','IN-APP APPROVAL','<div class="idle"><div><b>No credit issued</b>A human rejected the action. Nothing touched Stripe.</div></div>')}
 if(i===4)runLog()}
function runLog(){const L=$('log');const lines=chaos?
 [['d','→ POST /v1/customers/cus_acme…/balance_transactions'],['d','  idempotency_key: inc47-acme-credit'],['o','✕ request timed out after 10s'],['o','  state → OUTCOME_UNKNOWN · do NOT blindly retry'],['d','→ read Stripe: list balance transactions for cus_acme…'],['g','✓ found 1 credit with metadata case=INC-47'],['g','  the write succeeded. no second credit issued.']]:
 [['d','→ POST /v1/customers/cus_acme…/balance_transactions'],['d','  amount: -42000 · currency: usd'],['d','  metadata: case=INC-47 policy=sla-policy-v1'],['d','  idempotency_key: inc47-acme-credit'],['g','✓ 200 OK · transport success'],['o','  …but that alone proves nothing. verifying →']];
 timers.forEach(clearTimeout);timers=[];L.innerHTML='';lines.forEach((l,k)=>timers.push(setTimeout(()=>{L.innerHTML+=`<div class="${l[0]}">${l[1]}</div>`},k*450)));
 $('next').disabled=true;timers.push(setTimeout(()=>{$('next').disabled=false},lines.length*450))}
function reset(c){timers.forEach(clearTimeout);chaos=!!c;step=-1;states(-1);$('next').disabled=false;$('next').textContent='Run SLA Copilot →';
 pane(c?'Timeout replay':'Ready',c?'CHAOS MODE · STRIPE WILL TIME OUT':'DEMO DATA · STRIPE TEST MODE',`<div class="idle"><div><b>${c?'Same incident, flaky network':'Resolved incident'}</b>${c?'This time the Stripe request times out after the write succeeds.<br>A naive agent would retry and credit Acme twice.':'Press “Run SLA Copilot” to walk through<br>evidence, policy, approval, credit and verification.'}</div></div>`)}
$('next').onclick=()=>go(step+1);$('chaos').onclick=()=>reset(true);$('reset').onclick=()=>reset(false);reset(false);
</script>

</Layout>
