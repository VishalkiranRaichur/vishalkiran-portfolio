<script is:inline>
addEventListener('scroll',()=>document.getElementById('nav').classList.toggle('sc',scrollY>10),{passive:true});
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -8% 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));
// ---------- mini physics ----------
(()=>{const box=document.getElementById('cv'),cv=document.getElementById('pc'),cx=cv.getContext('2d');let W,H,dpr=Math.min(2,devicePixelRatio||1),B=[],drag=null,hist=[],running=false,still=0;
 const rm=matchMedia('(prefers-reduced-motion:reduce)').matches;
 function size(){const r=box.getBoundingClientRect();W=r.width;H=r.height;cv.width=W*dpr;cv.height=H*dpr;cx.setTransform(dpr,0,0,dpr,0,0)}
 function make(){B=[];const n=W<500?5:8;for(let i=0;i<n;i++){const stand=i%3===0;B.push({x:60+Math.random()*(W-120),y:-60-i*70,vx:(Math.random()-.5)*2,vy:0,r:stand?44:26,stand,a:0,va:(Math.random()-.5)*.1})}}
 function step(){const g=.45;let energy=0;
  for(const b of B){if(b===drag)continue;b.vy+=g;b.x+=b.vx;b.y+=b.vy;b.a+=b.va;b.vx*=.995;b.va*=.98;
   if(b.y>H-b.r){b.y=H-b.r;b.vy*=-.45;b.vx*=.9;b.va=b.vx*.02}
   if(b.x<b.r){b.x=b.r;b.vx*=-.6}if(b.x>W-b.r){b.x=W-b.r;b.vx*=-.6}
   energy+=Math.abs(b.vx)+Math.abs(b.vy)}
  for(let i=0;i<B.length;i++)for(let j=i+1;j<B.length;j++){const a=B[i],c=B[j],dx=c.x-a.x,dy=c.y-a.y,d=Math.hypot(dx,dy)||1,m=a.r+c.r;
   if(d<m){const nx=dx/d,ny=dy/d,o=(m-d)/2;if(a!==drag){a.x-=nx*o;a.y-=ny*o}if(c!==drag){c.x+=nx*o;c.y+=ny*o}
    const rv=(c.vx-a.vx)*nx+(c.vy-a.vy)*ny;if(rv<0){const k=-rv*.8;if(a!==drag){a.vx-=nx*k*.5;a.vy-=ny*k*.5}if(c!==drag){c.vx+=nx*k*.5;c.vy+=ny*k*.5}}}}
  return energy}
 function draw(){cx.clearRect(0,0,W,H);
  cx.strokeStyle='rgba(255,255,255,.05)';for(let x=0;x<W;x+=48){cx.beginPath();cx.moveTo(x,0);cx.lineTo(x,H);cx.stroke()}for(let y=0;y<H;y+=48){cx.beginPath();cx.moveTo(0,y);cx.lineTo(W,y);cx.stroke()}
  for(const b of B){cx.save();cx.translate(b.x,b.y);cx.rotate(b.a);
   if(b.stand){cx.fillStyle='#f3efe6';cx.fillRect(-32,-42,64,84);cx.fillStyle='#ff5a1f';cx.fillRect(-32,-42,64,6);cx.fillStyle='#111';cx.font='600 9px JO';cx.textAlign='center';cx.fillText('★★★★★',0,-22);cx.font='italic 11px serif';cx.fillText('How was',0,-6);cx.fillText('your visit?',0,7);
    for(let i=0;i<4;i++)for(let j=0;j<4;j++)if((i*7+j*3)%3)cx.fillRect(-10+i*5,16+j*5,4,4);}
   else{cx.fillStyle='#d9a441';cx.beginPath();cx.arc(0,0,b.r,0,7);cx.fill();cx.fillStyle='#b98428';cx.beginPath();cx.arc(0,0,b.r*.72,0,7);cx.fill();cx.fillStyle='#f6d58a';cx.font=`${b.r*.9}px serif`;cx.textAlign='center';cx.textBaseline='middle';cx.fillText('★',0,1)}
   cx.restore()}}
 function loop(){const e=step();draw();if(!drag&&e<.6*B.length){still++}else still=0;if(still>40){running=false;return}requestAnimationFrame(loop)}
 function wake(){still=0;if(!running){running=true;requestAnimationFrame(loop)}}
 function pos(e){const r=box.getBoundingClientRect();return{x:e.clientX-r.left,y:e.clientY-r.top}}
 box.addEventListener('pointerdown',e=>{const p=pos(e);drag=B.slice().reverse().find(b=>Math.hypot(b.x-p.x,b.y-p.y)<b.r);if(drag){box.setPointerCapture(e.pointerId);hist=[{...p,t:performance.now()}];drag.vx=drag.vy=0;wake()}});
 box.addEventListener('pointermove',e=>{if(!drag)return;const p=pos(e);drag.x=p.x;drag.y=p.y;hist.push({...p,t:performance.now()});if(hist.length>5)hist.shift()});
 const up=()=>{if(!drag)return;if(hist.length>1){const a=hist[0],b=hist[hist.length-1],dt=Math.max(16,b.t-a.t);drag.vx=(b.x-a.x)/dt*16;drag.vy=(b.y-a.y)/dt*16;drag.va=drag.vx*.01}drag=null;wake()};
 box.addEventListener('pointerup',up);box.addEventListener('pointercancel',up);
 document.getElementById('drop').onclick=()=>{make();wake()};
 size();addEventListener('resize',()=>{size();draw()});
 new IntersectionObserver((es,o)=>es.forEach(e=>{if(e.isIntersecting){make();if(rm){for(let i=0;i<400;i++)step();draw()}else wake();o.disconnect()}}),{threshold:.3}).observe(box);
})();
</script>

