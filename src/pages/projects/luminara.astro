<script is:inline>
addEventListener('scroll',()=>document.getElementById('nav').classList.toggle('sc',scrollY>10),{passive:true});
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -8% 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));
// ---------- simplifier demo ----------
const W=[
 {o:'autotrophic organisms',n:'living things that make their own food',pos:'adjective',def:'Able to make its own food, for example from sunlight.'},
 {o:'synthesize',n:'make',pos:'verb',def:'To build something by combining simpler parts.'},
 {o:'utilizing',n:'using',pos:'verb',def:'Using something for a purpose.'},
 {o:'facilitate',n:'help',pos:'verb',def:'To make an action or process easier.'},
 {o:'subsequently',n:'then',pos:'adverb',def:'Coming after something in time.'},
 {o:'metabolic',n:'energy',pos:'adjective',def:'Related to the chemical processes that keep a living thing alive.'}];
const T=['<h6>Chapter 8 · Photosynthesis</h6>Photosynthesis is the process by which ',0,' ',1,' carbohydrates, ',2,' light energy to ',3,' the conversion of carbon dioxide and water. The resulting glucose is ',4,' used to fuel ',5,' reactions throughout the cell.'];
let mode='flag';const saved=new Set();
function render(){const d=document.getElementById('doc');d.className='doc mode-'+mode;
 d.innerHTML=T.map(x=>typeof x==='number'?`<span class="w${saved.has(x)?' saved':''}" data-i="${x}">${mode==='new'?W[x].n:W[x].o}</span>`:x).join('');
 document.getElementById('mlabel').innerHTML=mode==='orig'?'READING GRADE · <b>COLLEGE</b>':mode==='flag'?'FLAGGED SPANS · <b>6</b>':'REWRITTEN · <b>6 SPANS ONLY</b> · REST UNCHANGED';
 d.querySelectorAll('.w').forEach(s=>s.onclick=()=>save(+s.dataset.i))}
function save(i){if(saved.has(i))return;saved.add(i);const w=W[i],dict=document.getElementById('dict');const e=dict.querySelector('.empty');if(e)e.remove();
 const word=w.o.split(' ')[0];dict.insertAdjacentHTML('afterbegin',`<div class="de"><b>${word}</b><small>${w.pos.toUpperCase()}</small><p>${w.def}</p></div>`);render()}
document.querySelectorAll('#modes button').forEach(b=>b.onclick=()=>{mode=b.dataset.m;document.querySelectorAll('#modes button').forEach(x=>x.classList.toggle('on',x===b));render()});
render();
</script>

