---
import Layout from '../../layouts/Layout.astro';
---
<Layout title='Luminara · Vishalkiran Raichur' description='An accessible-reading app. I led the backend.' active="projects">
<style is:global>




.vf{position:relative;border:1px solid var(--ink);background:var(--paper)}
.vf .c{position:absolute;width:16px;height:16px;border-color:var(--ink);border-style:solid;z-index:2}
.vf .tl{left:10px;top:10px;border-width:1px 0 0 1px}.vf .tr{right:10px;top:10px;border-width:1px 1px 0 0}.vf .bl{left:10px;bottom:10px;border-width:0 0 1px 1px}.vf .br{right:10px;bottom:10px;border-width:0 1px 1px 0}
.vf .hd,.vf .ft{display:flex;justify-content:space-between;gap:20px;padding:16px 34px;font-family:PM;font-size:10px;letter-spacing:.16em}
.vf .ft{color:var(--mut)}
.back{display:inline-flex;gap:10px;margin-top:56px;font-size:12px;letter-spacing:.2em;text-transform:uppercase}
.meta{display:flex;gap:14px;align-items:center;margin-top:40px;flex-wrap:wrap}
.meta .ln{width:34px;height:1px;background:var(--line)}
.rec{width:6px;height:6px;border-radius:50%;background:var(--or);display:inline-block;margin-right:8px;animation:rec 1.6s steps(1) infinite}
@keyframes rec{50%{opacity:.2}}
h1{font-weight:300;font-size:clamp(90px,14vw,210px);line-height:.86;text-transform:uppercase;margin-top:18px}
h1 .o{display:inline-block;width:.74em;height:.74em;border:.035em solid var(--ink);border-radius:50%;position:relative;vertical-align:-.02em}
h1 .o::after{content:"";position:absolute;left:50%;top:50%;width:.12em;height:.12em;margin:-.06em;border-radius:50%;background:var(--or)}
.top{display:grid;grid-template-columns:1fr 400px;gap:60px;align-items:end}
.kick{font-weight:300;font-size:clamp(30px,3vw,44px);line-height:1.12;text-transform:uppercase;margin-top:30px;max-width:820px}
.kick span{color:var(--mut)}
.lede{font-size:20px;line-height:1.6;color:#2b2a28;margin-top:22px;max-width:720px}
.acts{display:flex;gap:12px;margin-top:30px;flex-wrap:wrap}
.facts{border-top:1px solid var(--ink)}
.facts div{display:flex;justify-content:space-between;gap:20px;padding:13px 0;border-bottom:1px solid var(--line);font-size:15px;text-align:right}
.facts div span:first-child{font-family:PM;font-size:10.5px;letter-spacing:.14em;color:var(--mut);text-transform:uppercase;padding-top:3px;text-align:left}
/* section frame */
.sec{margin-top:150px}
.sl{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--ink);padding-top:16px}
.sl .n{color:var(--or)}
.sh{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:34px;align-items:end}
.sh h2{font-weight:300;font-size:clamp(42px,4.8vw,72px);line-height:1;text-transform:uppercase}
.sh p{font-size:18px;line-height:1.65;color:#2b2a28}
.sh p b{font-weight:500}
/* problem */
.prob{display:grid;grid-template-columns:1.2fr 1fr;margin-top:50px;border:1px solid var(--ink)}
.prob svg{width:100%;height:auto;display:block}
.prob .r{border-left:1px solid var(--ink);padding:36px;display:flex;flex-direction:column;justify-content:space-between;background:#f6f2ea}
.prob .q{font-weight:300;font-size:30px;line-height:1.2;margin-top:16px}
.ppl{border-top:1px solid var(--line);margin-top:26px}
.ppl div{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line);font-size:15px}
.ppl div span:last-child{font-family:PM;font-size:10.5px;letter-spacing:.12em;color:var(--mut)}
.prob .then{font-size:17px;line-height:1.6;margin-top:24px}
.prob .then b{font-weight:500;border-bottom:1px solid var(--or)}
/* product tabs */
.tabs{display:flex;gap:0;margin-top:50px;border:1px solid var(--ink);border-bottom:0;width:max-content}
.tabs button{all:unset;cursor:pointer;padding:14px 26px;font-size:12px;letter-spacing:.2em;text-transform:uppercase;border-right:1px solid var(--ink);display:flex;gap:10px;align-items:center;transition:background .25s,color .25s}
.tabs button:last-child{border-right:0}
.tabs button sup{font-family:PM;font-size:9px;color:var(--dim)}
.tabs button.on{background:var(--ink);color:var(--paper)}
.tabs button.on sup{color:var(--or)}
.screen{border:1px solid var(--ink);position:relative;background:var(--paper)}
.screen .hd{border-bottom:1px solid var(--line)}
.pane{display:none;padding:30px 34px 34px;min-height:520px;animation:fd .5s cubic-bezier(.2,.8,.2,1)}
.pane.on{display:block}
@keyframes fd{from{opacity:0;transform:translateY(10px)}}
.cap{display:grid;grid-template-columns:1fr 1.4fr;gap:40px;margin-top:22px;align-items:start}
.cap h4{font-weight:300;font-size:30px;text-transform:uppercase}
.cap p{font-size:16.5px;line-height:1.6;color:#2b2a28}
/* concept UI pieces */
.ui{border:1px solid var(--line);background:#fff;border-radius:2px}
.ui .bar{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line);font-family:PM;font-size:10px;letter-spacing:.12em;color:var(--mut)}
.kpis{display:grid;grid-template-columns:repeat(4,1fr)}
.kpi{padding:18px 16px;border-right:1px solid var(--line)}.kpi:last-child{border:0}
.kpi small{font-family:PM;font-size:9.5px;letter-spacing:.12em;color:var(--mut)}
.kpi b{display:block;font-weight:300;font-size:32px;margin-top:8px}
.kpi em{font-style:normal;font-family:PM;font-size:10.5px}
.dn{color:var(--or)}.up{color:#1f7a4d}
.dgrid{display:grid;grid-template-columns:1.6fr 1fr;border-top:1px solid var(--line)}
.dgrid>div{padding:16px}
.dgrid>div+div{border-left:1px solid var(--line)}
.ins{border:1px solid var(--line);padding:12px;margin-top:10px;font-size:13.5px;line-height:1.5}
.ins .t{font-family:PM;font-size:9.5px;letter-spacing:.12em;color:var(--or)}
.ins b{font-weight:500}
.askbox{border:1px solid var(--ink);padding:16px 18px;font-size:16px;display:flex;justify-content:space-between;align-items:center}
.askbox .k{font-family:PM;font-size:10px;border:1px solid var(--ink);padding:6px 10px;background:var(--ink);color:#fff}
.ans{display:grid;grid-template-columns:1.5fr 1fr;gap:0;margin-top:14px;border:1px solid var(--line)}
.ans>div{padding:18px}.ans>div+div{border-left:1px solid var(--line);background:#faf8f3}
.ans p{font-size:14.5px;line-height:1.65;color:#2b2a28}
.ans sup{font-family:PM;font-size:9px;color:var(--or);margin-left:2px}
.ans ul{list-style:none;margin-top:10px}
.ans li{font-size:14px;padding:8px 0;border-top:1px solid var(--line);line-height:1.5}
.src{display:flex;gap:10px;padding:10px 0;border-top:1px solid var(--line);font-size:13px;line-height:1.45}
.src i{font-style:normal;font-family:PM;font-size:9.5px;color:var(--or);min-width:16px}
.src small{display:block;font-family:PM;font-size:9.5px;color:var(--mut);letter-spacing:.06em}
.conf{display:flex;gap:10px;align-items:center;margin-top:14px;font-family:PM;font-size:10px;letter-spacing:.12em;color:var(--mut)}
.conf i{flex:1;height:4px;background:rgba(17,17,17,.1);position:relative}.conf i b{position:absolute;inset:0 auto 0 0;background:var(--ink)}
.inv{display:grid;grid-template-columns:1fr 1.2fr;border:1px solid var(--line);margin-top:14px}
.inv>div{padding:18px}.inv>div+div{border-left:1px solid var(--line);background:#faf8f3}
.stp{display:grid;grid-template-columns:26px 1fr auto;gap:10px;padding:11px 0;border-top:1px solid var(--line);font-size:14px;align-items:center}
.stp:first-of-type{border-top:0}
.stp .n{font-family:PM;font-size:10px;color:var(--mut)}
.stp .s{font-family:PM;font-size:9.5px;letter-spacing:.1em}
.stp.dn2 .s{color:#1f7a4d}.stp.now .s{color:var(--or)}
.stp.now{font-weight:500}
.brf .r{display:grid;grid-template-columns:110px 1fr;gap:12px;padding:10px 0;border-top:1px solid var(--line);font-size:14px;line-height:1.5}
.brf .r small{font-family:PM;font-size:9px;letter-spacing:.12em;color:var(--mut);padding-top:3px}
.brf .r b{font-weight:500}
.lbl{font-family:PM;font-size:9.5px;letter-spacing:.14em;border:1px solid var(--or);color:var(--or);padding:3px 7px}
/* built vs vision */
.board{display:grid;grid-template-columns:1fr 1fr;margin-top:50px;border:1px solid var(--ink)}
.board>div{padding:30px 34px}
.board>div+div{border-left:1px solid var(--ink);background:#f6f2ea}
.board h4{display:flex;justify-content:space-between;align-items:center;font-weight:300;font-size:30px;text-transform:uppercase}
.board h4 span{font-family:PM;font-size:11px;letter-spacing:.14em;color:var(--mut)}
.it{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:14px 0;border-top:1px solid var(--line);font-size:16.5px}
.it:first-of-type{margin-top:20px}
.it .s{font-family:PM;font-size:10px;letter-spacing:.12em;white-space:nowrap}
.it .s.b::before{content:"● ";color:var(--or)}
.it .s.p::before{content:"○ ";color:var(--mut)}
.proof{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--ink);border-top:0}
.proof div{padding:26px 28px;border-right:1px solid var(--line)}.proof div:last-child{border:0}
.proof b{display:block;font-weight:300;font-size:54px;line-height:1}
.proof b em{font-style:normal;color:var(--or)}
.proof small{display:block;font-size:14.5px;color:#3a3936;margin-top:10px;line-height:1.45}
/* control */
.duo{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}
.brief{padding:26px 34px 30px}
.brief+.brief{border-left:1px solid var(--line);background:#f6f2ea}
.brief .q{font-size:21px;margin-top:10px}
.brief .r{display:grid;grid-template-columns:130px 1fr;gap:14px;padding:12px 0;border-top:1px solid var(--line);font-size:15px;line-height:1.5;color:#2b2a28}
.brief .r:first-of-type{margin-top:16px}
.brief .r small{font-family:PM;font-size:9.5px;letter-spacing:.14em;color:var(--mut);padding-top:4px}
.brief .r b{font-weight:500;color:var(--ink)}
.brief .x{color:var(--or)}
.mtr{display:flex;align-items:center;gap:12px}.mtr i{flex:1;height:4px;background:rgba(17,17,17,.1);position:relative}.mtr i b{position:absolute;inset:0 auto 0 0;background:var(--ink)}
.brief+.brief .mtr i b{background:var(--or)}
.note{margin-top:22px;display:grid;grid-template-columns:200px 1fr;gap:40px;border-top:1px solid var(--line);padding-top:20px}
.note p{font-size:16.5px;line-height:1.65;color:#2b2a28;max-width:820px}
.note p b{font-weight:500}
/* six capabilities */
.six{display:grid;grid-template-columns:repeat(3,1fr);margin-top:50px;border-top:1px solid var(--ink);border-left:1px solid var(--ink)}
.cp{border-right:1px solid var(--ink);border-bottom:1px solid var(--ink);padding:26px 26px 30px;min-height:300px;display:flex;flex-direction:column;transition:background .3s}
.cp:hover{background:#f6f2ea}
.cp .h{display:flex;justify-content:space-between;align-items:center}
.cp .h .n{font-family:PM;font-size:11px;color:var(--or);letter-spacing:.1em}
.st{font-family:PM;font-size:9.5px;letter-spacing:.12em;padding:4px 8px;border:1px solid var(--ink)}
.st.b{background:var(--ink);color:var(--paper)}
.st.f{border-style:dashed;color:var(--mut);border-color:var(--dim)}
.cp h4{font-weight:300;font-size:30px;text-transform:uppercase;margin-top:44px;line-height:1.05}
.cp p{font-size:15.5px;line-height:1.6;color:#3a3936;margin-top:12px}
.cp .ex{margin-top:auto;padding-top:18px;font-family:PM;font-size:11px;color:var(--mut);line-height:1.55}
.cp .ex b{color:var(--ink);font-weight:400}
.alert{border:1px solid var(--or);padding:12px 14px;margin-top:18px;background:#fff}
.alert .t{display:flex;justify-content:space-between;font-family:PM;font-size:9.5px;letter-spacing:.12em;color:var(--or)}
.alert b{display:block;font-weight:500;font-size:15px;margin-top:6px}
.alert p{font-size:13px!important;margin-top:4px!important}
/* arch */
.arch{display:grid;grid-template-columns:1.3fr 1fr;gap:60px;margin-top:50px;align-items:start}
.layers{border:1px solid var(--ink)}
.ly{display:grid;grid-template-columns:44px 1fr auto;gap:16px;align-items:center;padding:20px 22px;border-bottom:1px solid var(--line);position:relative}
.ly:last-child{border:0}
.ly .n{font-family:PM;font-size:10.5px;color:var(--mut)}
.ly h5{font-weight:400;font-size:19px;text-transform:uppercase;letter-spacing:.03em}
.ly p{font-family:PM;font-size:11px;color:var(--mut);margin-top:4px;letter-spacing:.02em}
.ly.core{background:#f6f2ea}
.surf{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--ink)}
.surf div{padding:16px;text-align:center;font-size:14px;letter-spacing:.16em;text-transform:uppercase;border-right:1px solid var(--line)}.surf div:last-child{border:0;color:var(--mut)}
.prin{border-top:1px solid var(--ink)}
.prin div{display:grid;grid-template-columns:34px 1fr;padding:16px 0;border-bottom:1px solid var(--line);font-size:17px}
.prin span{font-family:PM;font-size:10.5px;color:var(--or);padding-top:4px}
/* users + chatgpt */
.users{display:grid;grid-template-columns:repeat(5,1fr);margin-top:50px;border-top:1px solid var(--ink)}
.users div{padding:22px 20px 0 0}
.users h5{font-weight:400;font-size:18px;text-transform:uppercase;letter-spacing:.03em}
.users p{font-size:14.5px;line-height:1.55;color:#3a3936;margin-top:8px}
.vs{display:grid;grid-template-columns:1fr 1fr;margin-top:50px;border:1px solid var(--ink)}
.vs>div{padding:30px 34px}.vs>div+div{border-left:1px solid var(--ink);background:var(--ink);color:var(--paper)}
.vs h5{font-family:PM;font-size:10.5px;letter-spacing:.16em;font-weight:400;color:var(--mut)}
.vs>div+div h5{color:var(--or)}
.vs ul{list-style:none;margin-top:16px}
.vs li{padding:12px 0;border-top:1px solid var(--line);font-size:16px}
.vs>div+div li{border-color:rgba(255,255,255,.15)}
.claim{margin-top:60px;text-align:center;font-weight:300;font-size:clamp(34px,4vw,58px);line-height:1.1;text-transform:uppercase;max-width:1100px;margin-left:auto;margin-right:auto}
.claim span{color:var(--or)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:30px;justify-content:center}
.chips span{font-family:PM;font-size:11px;border:1px solid var(--line);border-radius:999px;padding:6px 12px;color:#3a3936}
.next{display:grid;grid-template-columns:1fr auto;align-items:end;margin-top:140px;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);padding:44px 0;transition:padding .4s}
.next:hover{padding-left:16px}
.next h2{font-weight:300;font-size:clamp(56px,9vw,140px);line-height:.9;text-transform:uppercase;margin-top:16px}
.next p{font-family:PM;font-size:13px;color:var(--mut);margin-top:14px}
.bigarr{width:84px;height:84px;border:1px solid var(--ink);border-radius:50%;display:grid;place-items:center;transition:.3s}
.next:hover .bigarr{background:var(--ink);color:var(--paper)}
.foot{border-top:1px solid var(--ink);display:grid;grid-template-columns:repeat(4,1fr);gap:40px;padding:40px 0 60px;margin-top:100px}
.foot b{display:block;font-weight:400;font-size:15px;margin-top:12px;line-height:1.8}
.rv{opacity:0;transform:translateY(24px);transition:opacity 1s cubic-bezier(.2,.8,.2,1),transform 1s cubic-bezier(.2,.8,.2,1)}
.rv.in{opacity:1;transform:none}.d1{transition-delay:.1s}.d2{transition-delay:.2s}
@media (max-width:960px){
 .wrap{padding:0 18px}.links,.srch .t{display:none}.srch{gap:6px;padding:8px 10px}.nr .pillb{display:none}
 h1{font-size:76px}.top,.sh,.prob,.cap,.board,.arch,.vs,.note{grid-template-columns:1fr;gap:28px}
 .prob .r,.board>div+div,.vs>div+div{border-left:0;border-top:1px solid var(--ink)}
 .tabs{width:100%}.tabs button{flex:1;justify-content:center;padding:12px 8px;font-size:10.5px;letter-spacing:.1em}.tabs button sup{display:none}
 .pane{padding:18px}.kpis{grid-template-columns:1fr 1fr}.kpi:nth-child(2){border:0}.dgrid,.ans,.inv{grid-template-columns:1fr}.dgrid>div+div,.ans>div+div,.inv>div+div{border-left:0;border-top:1px solid var(--line)}
 .proof{grid-template-columns:1fr 1fr}.duo{grid-template-columns:1fr}.brief+.brief{border-left:0}.brief{padding:20px 18px}.brief .r{grid-template-columns:1fr;gap:4px}
 .six{grid-template-columns:1fr}.cp{min-height:0}.users{grid-template-columns:1fr 1fr;gap:10px}
 .next{grid-template-columns:1fr;gap:20px}.bigarr{width:56px;height:56px}.foot{grid-template-columns:1fr 1fr}.vf .hd,.vf .ft{padding:14px 18px;flex-wrap:wrap}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}}

img{display:block;max-width:100%}
/* real app */
.real{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:70px}
.real .vf{padding:44px 22px 46px}
.real .vf .hd{position:absolute;top:0;left:0;right:0}.real .vf .ft{position:absolute;bottom:0;left:0;right:0}
.real img,.real video{display:block;width:100%;border:1px solid var(--line);background:#f1ede6}
.real p{font-size:15.5px;line-height:1.6;color:#3a3936;margin-top:14px}
.real p b{font-weight:500}
@media (max-width:960px){.real{grid-template-columns:1fr}.real .vf{padding:40px 10px 42px}}
/* audiences */
.aud{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--ink);margin-top:50px}
.au{padding:26px 26px 30px;border-right:1px solid var(--line);min-height:230px;display:flex;flex-direction:column}
.au:last-child{border:0}
.au span{font-family:PM;font-size:10px;color:var(--or);letter-spacing:.12em}
.au h5{font-weight:300;font-size:30px;text-transform:uppercase;margin-top:auto;line-height:1.05}
.au p{font-size:15px;line-height:1.55;color:#3a3936;margin-top:10px}
.quote2{border:1px solid var(--ink);border-top:0;padding:22px 26px;background:#f6f2ea;font-weight:300;font-size:26px;line-height:1.25;text-transform:uppercase}
.quote2 em{font-style:normal;color:var(--or)}
/* demo */
.demo{display:grid;grid-template-columns:1.5fr 1fr;border:1px solid var(--ink);margin-top:50px}
.dl{padding:28px 32px}
.dr{border-left:1px solid var(--ink);padding:28px 30px;background:#f6f2ea;display:flex;flex-direction:column}
.modes{display:flex;border:1px solid var(--ink);width:max-content}
.modes button{all:unset;cursor:pointer;padding:10px 16px;font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;border-right:1px solid var(--ink)}
.modes button:last-child{border:0}
.modes button.on{background:var(--ink);color:var(--paper)}
.doc{border:1px solid var(--line);background:#fff;padding:26px 28px;margin-top:18px;font-size:20px;line-height:1.75;min-height:250px;font-family:Georgia,serif;color:#222}
.doc h6{font-family:JO;font-weight:500;font-size:13px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:12px;color:var(--ink)}
.w{border-radius:2px;transition:background .3s,color .3s;cursor:pointer}
.mode-flag .w{background:rgba(255,90,31,.16);border-bottom:2px solid var(--or)}
.mode-flag .w:hover{background:rgba(255,90,31,.3)}
.mode-new .w{background:rgba(31,122,77,.1);border-bottom:2px solid #1f7a4d}
.mode-orig .w{background:none}
.w.saved{outline:1px dashed var(--ink);outline-offset:2px}
.meter{display:flex;justify-content:space-between;align-items:center;margin-top:14px;font-family:PM;font-size:10.5px;letter-spacing:.1em;color:var(--mut)}
.meter b{font-weight:400;color:var(--ink);font-size:13px}
.dict{margin-top:14px;flex:1}
.de{border:1px solid var(--ink);background:#fff;padding:14px 16px;margin-top:10px;animation:fd .35s}
.de b{font-weight:500;font-size:18px}
.de small{font-family:PM;font-size:10px;color:var(--or);letter-spacing:.1em;margin-left:8px}
.de p{font-size:14px;line-height:1.5;color:#3a3936;margin-top:4px}
.empty{font-size:14.5px;line-height:1.6;color:var(--mut);margin-top:14px;border:1px dashed var(--dim);padding:16px}
/* sketch */
.sk{display:grid;grid-template-columns:1.25fr 1fr;border:1px solid var(--ink);margin-top:50px}
.sk .im{padding:26px;background:#f6f2ea;border-right:1px solid var(--ink)}
.sk .im img{border:1px solid var(--line);background:#fff;transform:rotate(-1deg);box-shadow:0 20px 40px rgba(0,0,0,.12)}
.sk .im .cap{font-family:PM;font-size:10px;letter-spacing:.12em;color:var(--mut);margin-top:16px}
