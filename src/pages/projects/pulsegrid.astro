<script is:inline>
addEventListener('scroll',()=>document.getElementById('nav').classList.toggle('sc',scrollY>10),{passive:true});
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -8% 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));
const T=['PULSEGRID · WORKFLOW RUN','PULSEGRID · WORKERS','PULSEGRID · ON GITHUB'];
const bs=[...document.querySelectorAll('#tabs button')],ps=[...document.querySelectorAll('.pane')];
bs.forEach(b=>b.onclick=()=>{const i=+b.dataset.p;bs.forEach(x=>x.classList.toggle('on',x===b));ps.forEach((p,j)=>p.classList.toggle('on',j===i));document.getElementById('ptitle').textContent=T[i]});
// ---- crash simulation ----
const $=id=>document.getElementById(id),evs=[...document.querySelectorAll('.ev')];
let timers=[],hb=null;
function pulseAlong(pathId){const p=$(pathId),L=p.getTotalLength(),dot=$('pulse');let t0=performance.now();dot.setAttribute('opacity',1);
 cancelAnimationFrame(hb);(function f(t){const k=((t-t0)%900)/900,pt=p.getPointAtLength(L*(1-k));dot.setAttribute('cx',pt.x);dot.setAttribute('cy',pt.y);hb=requestAnimationFrame(f)})(t0)}
function stopPulse(){cancelAnimationFrame(hb);$('pulse').setAttribute('opacity',0)}
function step(n){evs.forEach(e=>{const s=+e.dataset.s;e.classList.toggle('on',s<=n);e.classList.toggle('cur',s===n)});$('clock').textContent='T+'+String([0,0,8,14,44,45,52,60][n]).padStart(2,'0')+'s'}
function reset(){timers.forEach(clearTimeout);timers=[];stopPulse();step(0);
 $('lease').textContent='LEASE: —';$('wat').textContent='IDLE';$('wbt').textContent='IDLE';$('wa').setAttribute('opacity',1);$('wb').setAttribute('opacity',.35);
 $('la').setAttribute('opacity',1);$('lb').setAttribute('opacity',.25);$('x').setAttribute('opacity',0);$('fence').setAttribute('opacity',0);$('la').setAttribute('stroke','#111')}
function run(){reset();const at=(ms,f)=>timers.push(setTimeout(f,ms));
 at(200,()=>{step(1);$('lease').textContent='LEASE 7f3c → WORKER A';$('wat').textContent='JOB 42 · RUNNING'});
 at(1300,()=>{step(2);pulseAlong('la')});
 at(3300,()=>{step(3);stopPulse();$('x').setAttribute('opacity',1);$('wa').setAttribute('opacity',.35);$('wat').textContent='NO HEARTBEAT';$('la').setAttribute('stroke','#ff5a1f')});
 at(4800,()=>{step(4);$('lease').textContent='LEASE 7f3c EXPIRED';$('la').setAttribute('opacity',.15)});
 at(6000,()=>{step(5);$('lease').textContent='LEASE 9a1e → WORKER B';$('wb').setAttribute('opacity',1);$('lb').setAttribute('opacity',1);$('wbt').textContent='JOB 42 · RETRY 1'});
 at(6800,()=>pulseAlong('lb'));
 at(8600,()=>{step(6);stopPulse();$('wbt').textContent='JOB 42 · PASSED ✓'});
 at(9800,()=>{step(7);$('x').setAttribute('opacity',0);$('wa').setAttribute('opacity',1);$('wat').textContent='BACK · OLD LEASE 7f3c';$('fence').setAttribute('opacity',1)});
}
$('go').onclick=run;$('rs').onclick=reset;reset();
</script>

</Layout>
