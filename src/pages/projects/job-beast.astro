 ['Build + validate','QUALITY GATE','Generating a PDF is not enough.','The résumé builder picks the strongest verified material, writes LaTeX and compiles it. Then the output is checked: <b>one page, required sections, no clipped or overlapping text, no forbidden terms.</b>','tailor → latex → pdf<br>validate: one page <span class="g">✓</span> · sections <span class="g">✓</span> · overlap <span class="g">✓</span><br>forbidden terms: <span class="g">none</span>'],
 ['Hand off','EXECUTE','AI is an executor, not the brain.','Job Beast writes a packet and operator instructions. A browser operator fills the live form. <b>CAPTCHA, MFA, account logins and unclear legal questions park that one application</b> while the rest of the batch keeps moving.','job 118 → <span class="o">READY_FOR_HUMAN_MFA</span> · parked<br>job 119 → filled · awaiting authorization<br>job 120 → <span class="d">NEEDS_INPUT</span> · new legal question'],
 ['Verify the outcome','CONFIRM','An action is not the same as an outcome.','Clicking Submit proves nothing. Only an <b>employer confirmation</b> makes a job SUBMITTED. Otherwise it\'s SUBMITTED_UNVERIFIED, which still blocks a duplicate application across every source.','clicked submit → redirect …<br>confirmation page found → <span class="g">SUBMITTED</span><br><span class="d">no confirmation → SUBMITTED_UNVERIFIED</span>']];
$('plist').innerHTML=P.map((p,i)=>`<button class="pi${i?'':' on'}" data-i="${i}"><span>${String(i+1).padStart(2,'0')}</span>${p[0]}<i>${p[1]}</i></button>`).join('');
function showP(i){document.querySelectorAll('.pi').forEach((b,j)=>b.classList.toggle('on',j===i));const p=P[i];
 $('pdet').outerHTML=`<div class="pdet" id="pdet"><div class="m"><span class="or">${String(i+1).padStart(2,'0')}</span> · ${p[0]}</div><div class="q">“${p[2]}”</div><p>${p[3]}</p><div class="viz"><div class="m" style="margin-bottom:10px">Example</div><div class="box">${p[4]}</div></div></div>`}
document.querySelectorAll('.pi').forEach(b=>b.onclick=()=>showP(+b.dataset.i));showP(0);
// ---------- ranking ----------
const J=[{n:'Data Platform Intern',age:'posted 10 min ago',fit:48,bonus:0,note:'fit below floor → no bonus'},{n:'Backend Engineering Intern',age:'posted yesterday',fit:86,bonus:3,note:'strong fit, small bonus'},{n:'ML Infrastructure Intern',age:'posted 2 hours ago',fit:78,bonus:12,note:'fast lane: ≤3h and fit ≥70'}];
function drawJobs(mode){const order=mode==='time'?[0,2,1]:[2,1,0];
 $('jobs').innerHTML=order.map((k,r)=>{const j=J[k],showB=mode!=='time';const tot=j.fit+(showB?j.bonus:0);
  return `<div class="jb"><div class="h"><b>${r+1}. ${j.n}</b><span>${j.age}</span></div><div class="track"><div class="fit" style="width:${j.fit}%"></div><div class="bon" style="width:${showB?j.bonus:0}%"></div></div>${mode==='time'?'':`<div style="font-family:PM;font-size:10.5px;color:${k===2?'var(--or)':'var(--mut)'};margin-top:6px">fit ${j.fit}${j.bonus?' + '+j.bonus+' bonus':''} · ${j.note}</div>`}</div>`}).join('')+
 (mode==='time'?'<p style="font-size:15px;margin-top:20px;color:var(--or)">The weakest match is on top just because it\'s newest.</p>':'<p style="font-size:15px;margin-top:20px">Strong, fresh roles first. A brand-new weak match drops to the bottom.</p>')}
document.querySelectorAll('#sw button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#sw button').forEach(x=>x.classList.toggle('on',x===b));drawJobs(b.dataset.m)});drawJobs('time');
</script>

