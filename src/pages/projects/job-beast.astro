     <rect x="620" y="150" width="220" height="40" fill="#fff" stroke="#ff5a1f"/><text x="730" y="175" fill="#ff5a1f">HUMAN_CAPTCHA</text>
     <rect x="620" y="240" width="220" height="40" fill="#fff" stroke="#ff5a1f"/><text x="730" y="265" fill="#ff5a1f">HUMAN_MFA</text>
     <rect x="920" y="60" width="230" height="40" fill="#14130f"/><text x="1035" y="85" fill="#fcfaf6">SUBMITTED ✓</text>
