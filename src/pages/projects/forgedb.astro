<script is:inline>
addEventListener('scroll',()=>document.getElementById('nav').classList.toggle('sc',scrollY>10),{passive:true});
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -8% 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));
const $=id=>document.getElementById(id);
// ---------- query journey ----------
const Q=[
 {path:{shell:'',parser:'',engine:'',catalog:'IS ID INDEXED? YES',index:'WALK TREE → 1 ROW',buffer:'1–2 PAGES',disk:'ONLY IF NOT CACHED'},hot:['index'],
  txt:'<b>Fast path.</b> The catalog says <b>id</b> is the primary key with a B+ tree, so the engine walks the tree straight to the one row. The record manager is skipped for searching.'},
 {path:{shell:'',parser:'',engine:'',catalog:'IS GPA INDEXED? NO',record:'DECODE EVERY ROW',buffer:'EVERY PAGE',disk:'WHOLE PAGE CHAIN'},hot:['record'],
  txt:'<b>Full scan.</b> <b>gpa</b> has no index, so the record manager reads every page in the chain and checks each row against the condition.'},
 {path:{shell:'',parser:'',engine:'',catalog:'CHECK SCHEMA + KEY',record:'ENCODE ROW → SLOT',index:'INSERT KEY 4',buffer:'MARK PAGE DIRTY',disk:'FLUSHED ON EVICT'},hot:['record','index'],
  txt:'<b>Write path.</b> The catalog checks the schema and that key 4 is unique. The row is encoded into a free slot, the key goes into the B+ tree, and the page is marked <b>dirty</b> until it\'s flushed.'}];
const lyrs=[...document.querySelectorAll('.lyr')];
function showQ(i){document.querySelectorAll('.qb').forEach((b,j)=>b.classList.toggle('on',j===i));const q=Q[i];
 lyrs.forEach(l=>{l.classList.remove('on','hot');l.querySelector('.t').textContent=''});
 lyrs.forEach((l,k)=>{const key=l.dataset.l;if(key in q.path){setTimeout(()=>{l.classList.add('on');if(q.hot.includes(key))l.classList.add('hot');l.querySelector('.t').textContent=q.path[key]},k*90)}});
 $('qexp').innerHTML=q.txt}
document.querySelectorAll('.qb').forEach(b=>b.onclick=()=>showQ(+b.dataset.q));showQ(0);
// ---------- B+ tree ----------
const N={r:{x:230,y:20,k:[40]},a:{x:100,y:100,k:[17,29]},b:{x:360,y:100,k:[58,77]},
 l1:{x:10,y:190,k:[3,7,12]},l2:{x:120,y:190,k:[17,22]},l3:{x:210,y:190,k:[29,33]},l4:{x:300,y:190,k:[40,51]},l5:{x:390,y:190,k:[58,63]},l6:{x:470,y:190,k:[77,91]}};
const E=[['r','a'],['r','b'],['a','l1'],['a','l2'],['a','l3'],['b','l4'],['b','l5'],['b','l6']];
const w=n=>N[n].k.length*26+18;
$('edges').innerHTML=E.map(([p,c])=>`<line class="ed" id="e_${p}_${c}" x1="${N[p].x+w(p)/2}" y1="${N[p].y+30}" x2="${N[c].x+w(c)/2}" y2="${N[c].y}"/>`).join('')+
 ['l1','l2','l3','l4','l5'].map((n,i,a)=>{const m=['l2','l3','l4','l5','l6'][i];return `<line x1="${N[n].x+w(n)}" y1="${N[n].y+15}" x2="${N[m].x}" y2="${N[m].y+15}" stroke="#111" stroke-opacity=".25" stroke-dasharray="2 3"/>`}).join('');
$('nodes').innerHTML=Object.entries(N).map(([id,n])=>`<g class="nd" id="n_${id}"><rect x="${n.x}" y="${n.y}" width="${w(id)}" height="30"/>${n.k.map((k,i)=>`<text x="${n.x+9+i*26+10}" y="${n.y+20}" font-family="PM" font-size="11.5" text-anchor="middle">${k}</text>`).join('')}</g>`).join('')+
 `<text x="10" y="248" font-family="PM" font-size="9.5" fill="#6f6d68" letter-spacing="1">LEAVES LINKED FOR RANGE WALKS · ILLUSTRATIVE ORDER</text>`;
function find(k){document.querySelectorAll('.nd,.ed').forEach(e=>e.classList.remove('hit'));
 const inner=k<40?'a':'b',ks=N[inner].k;let leaf;
 if(inner==='a')leaf=k<17?'l1':k<29?'l2':'l3';else leaf=k<58?'l4':k<77?'l5':'l6';
 const steps=[['r',`root [40] → ${k}${k<40?' < ':' ≥ '}40, go ${k<40?'left':'right'}`],[inner,`internal [${ks.join(', ')}] → child for ${k}`],[leaf,N[leaf].k.includes(k)?`<span class="o">leaf hit: ${k} → page + slot ✓</span>`:`<span class="o">leaf [${N[leaf].k.join(', ')}]: ${k} not found</span>`]];
 $('out').innerHTML='';steps.forEach((s,i)=>setTimeout(()=>{$('n_'+s[0]).classList.add('hit');if(i)$(`e_${steps[i-1][0]}_${s[0]}`).classList.add('hit');$('out').innerHTML+=`${i+1}. ${s[1]}<br>`;if(i===2)$('out').innerHTML+=`<br>3 nodes visited instead of scanning every row.`},i*420))}
document.querySelectorAll('.findrow button').forEach(b=>b.onclick=()=>find(+b.dataset.k));
// ---------- buffer pool ----------
let pool=[],hits=0,miss=0,fl=0;
function drawPool(flash){$('slots').innerHTML=[0,1,2,3].map(i=>{const s=pool[i];if(!s)return `<div class="slot empty"><small>EMPTY</small><b></b></div>`;
 return `<div class="slot ${s.d?'dirty':''} ${flash&&flash.p===s.p?(flash.h?'hitp':'new'):''}"><small>${s.d?'DIRTY':'CLEAN'}${i===0?' · LRU':''}</small><b>p${s.p}</b></div>`}).join('');$('hits').textContent=hits;$('miss').textContent=miss;$('fl').textContent=fl}
function req(p,wr){let msg;const i=pool.findIndex(s=>s.p===p);
 if(i>=0){const s=pool.splice(i,1)[0];if(wr)s.d=true;pool.push(s);hits++;msg=`page ${p}: <b style="color:#1f7a4d">hit</b>, already in memory${wr?', now dirty':''}`;drawPool({p,h:1})}
 else{miss++;msg=`page ${p}: miss, read from disk`;if(pool.length===4){const ev=pool.shift();msg+=`<br>pool full → evict LRU page ${ev.p}`;if(ev.d){fl++;msg+=` <span style="color:var(--or)">(dirty: flushed to disk first)</span>`}}
  pool.push({p,d:!!wr});drawPool({p,h:0})}
 $('blog').innerHTML=msg}
document.querySelectorAll('.reqs button[data-p]').forEach(b=>b.onclick=()=>req(+b.dataset.p,b.dataset.w));
$('bpr').onclick=()=>{pool=[];hits=miss=fl=0;drawPool();$('blog').textContent='Pool is empty. Every first read goes to disk.'};drawPool();
